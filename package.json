{
  "name": "aurum-privee-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "verify:build": "npm run lint && npm run typecheck && npm test && npm run build",
    "verify": "npm run verify:build && playwright test",
    "verify:hosted": "tsx scripts/verify-hosted.ts",
    "test:migrations": "bash scripts/test-migrations.sh",
    "preflight:email": "tsx --env-file-if-exists=.env.local scripts/resend-preflight.ts",
    "preflight:wix": "tsx --env-file-if-exists=.env.local scripts/wix-preflight.ts",
    "catalog:wix:csv": "tsx --env-file-if-exists=.env.local scripts/generate-wix-import.ts",
    "catalog:wix:map": "tsx --env-file-if-exists=.env.local scripts/build-wix-catalog-map.ts",
    "catalog:relationships": "tsx scripts/generate-product-relationships.ts",
    "preflight:production": "tsx --env-file-if-exists=.env.local scripts/production-preflight.ts",
    "sync:loyverse:local": "tsx --env-file=.env.local scripts/sync-loyverse-local.ts",
    "images:check": "tsx scripts/import-product-images.ts --dry-run",
    "images:import": "tsx scripts/import-product-images.ts",
    "images:mirror-loyverse": "tsx scripts/mirror-loyverse-images.ts",
    "images:normalize": "tsx scripts/normalize-catalog-images.ts"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "^2.49.4",
    "@wix/ecom": "^1.0.2499",
    "@wix/redirects": "^1.0.128",
    "@wix/sdk": "^1.21.16",
    "@wix/stores": "^1.0.906",
    "next": "15.5.25",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.2.0",
    "server-only": "^0.0.1",
    "stripe": "22.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.17.24",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.23",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

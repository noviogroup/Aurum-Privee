# Public storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_CURRENCY=BSD
NEXT_PUBLIC_STORE_LOCALE=en-BS
NEXT_PUBLIC_PICKUP_LABEL="Nassau store pickup"
NEXT_PUBLIC_DELIVERY_FEE=10
# Fail-closed launch control. Set true only after the production acceptance checklist passes.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Supabase customer accounts. The publishable key is safe for browser use; never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Stripe adapter. Use only if the merchant has an account in a supported country.
# A Bahamas-registered merchant will likely need its bank's e-commerce gateway instead.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend. Verify aurumprivee.com before setting RESEND_DOMAIN_VERIFIED=true.
# Keep RESEND_API_KEY server-only and use a domain-restricted "Sending access" key in production.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL="Aurum Privée <orders@aurumprivee.com>"
RESEND_DOMAIN_VERIFIED=false
# Must be a real, monitored inbox. It does not need to use the sending domain.
STORE_NOTIFICATION_EMAIL=replace-with-monitored-order-inbox@example.com

# Loyverse custom integration
LOYVERSE_ACCESS_TOKEN=replace_me
# Token-mode callbacks use an unguessable URL token. OAuth callbacks instead use LOYVERSE_CLIENT_SECRET.
LOYVERSE_WEBHOOK_AUTH_MODE=token
LOYVERSE_WEBHOOK_TOKEN=replace_with_a_unique_long_random_value
# Optional. Required only when LOYVERSE_WEBHOOK_AUTH_MODE=oauth.
LOYVERSE_CLIENT_SECRET=
# Launch readiness compares the live Loyverse business and store names with this approved brand.
LOYVERSE_EXPECTED_BUSINESS_NAME="Aurum Privée"
# Set true only after replacing every development/chat-exposed token before production.
LOYVERSE_CREDENTIALS_ROTATED=false
LOYVERSE_MERCHANT_ID=replace_me
LOYVERSE_STORE_ID=replace_me
LOYVERSE_PAYMENT_TYPE_ID=replace_me
LOYVERSE_DELIVERY_VARIANT_ID=replace_me
# Comma-separated tax IDs applied to the delivery item; leave empty when untaxed.
LOYVERSE_DELIVERY_TAX_IDS=
# Sum of ADDED tax rates on the delivery item. The current account uses 10 when VAT applies.
LOYVERSE_DELIVERY_ADDED_TAX_RATE=0
LOYVERSE_SYNC_CUSTOMERS=true
# Regular expressions applied to Loyverse category names.
LOYVERSE_ONLINE_CATEGORY_PATTERN=fragrance
LOYVERSE_EXCLUDED_CATEGORY_PATTERN=tester

# HMAC key used to pseudonymize abuse-control fingerprints. Generate at least 32 random characters.
RATE_LIMIT_SECRET=replace_with_a_different_long_random_value
# Authorizes protected sync and recovery routes. Keep it distinct from every other secret.
SYNC_SECRET=replace_with_a_different_long_random_value
# Authorizes detailed health checks. Keep it out of public monitor URLs.
HEALTH_MONITOR_SECRET=replace_with_a_different_long_random_value

# Staff operations console. Keep both server-only and distinct from every integration secret.
OPERATIONS_PASSWORD=replace_with_a_unique_operator_password
# HMAC signing key for the HttpOnly operator session cookie. Generate at least 32 random characters.
OPERATIONS_SESSION_SECRET=replace_with_a_different_long_random_value
# Optional local visual-review records. Ignored in production even when set.
OPERATIONS_DEMO_MODE=false

# Netlify Blobs is provisioned automatically by Netlify and needs no credentials.

# Wix Headless commerce. Wix owns the production catalogue while both checkout switches
# remain false until fulfillment methods and hosted checkout have passed acceptance.
COMMERCE_PROVIDER=wix
# Public OAuth client ID used for visitor/member sessions; this value is safe in browser code.
NEXT_PUBLIC_WIX_CLIENT_ID=77a2c2cf-cc30-4612-b97c-c148ad908c1e
# Canonical production frontend used for Wix redirects even when NEXT_PUBLIC_SITE_URL is local.
WIX_STOREFRONT_ORIGIN=https://aurumprivee.com
# Server-only administrative authentication. Configure an API key, or an app secret,
# so the return page can verify the Wix order before confirming it or clearing the bag.
WIX_CLIENT_SECRET=replace_me
WIX_API_KEY=replace_me
WIX_SITE_ID=7cdfe7ac-5427-4d9f-b8bb-53e568ca63bd
WIX_CATALOG_VERSION=v3
# Must match the approved local catalog and generated Wix SKU map.
WIX_EXPECTED_SKU_COUNT=733
# Independent fail-closed Wix launch control.
WIX_CHECKOUT_ENABLED=false

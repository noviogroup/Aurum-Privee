# Public storefront
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_CURRENCY=BSD
NEXT_PUBLIC_STORE_LOCALE=en-BS
NEXT_PUBLIC_PICKUP_LABEL="Nassau store pickup"
NEXT_PUBLIC_DELIVERY_FEE=10
# Fail-closed launch control. Set true only after the production acceptance checklist passes.
NEXT_PUBLIC_CHECKOUT_ENABLED=false

# Stripe adapter. Use only if the merchant has an account in a supported country.
# A Bahamas-registered merchant will likely need its bank's e-commerce gateway instead.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL="Aurum Privée <orders@yourdomain.com>"
STORE_NOTIFICATION_EMAIL=orders@yourdomain.com

# Loyverse custom integration
LOYVERSE_ACCESS_TOKEN=replace_me
# Launch readiness compares the live Loyverse business and store names with this approved brand.
LOYVERSE_EXPECTED_BUSINESS_NAME="Aurum Privée"
# Set true only after replacing every development/chat-exposed token before production.
LOYVERSE_CREDENTIALS_ROTATED=false
LOYVERSE_MERCHANT_ID=replace_me
LOYVERSE_STORE_ID=replace_me
LOYVERSE_PAYMENT_TYPE_ID=replace_me
LOYVERSE_DELIVERY_VARIANT_ID=replace_me
# Comma-separated tax IDs applied to the delivery item; leave empty when untaxed.
LOYVERSE_DELIVERY_TAX_IDS=
# Sum of ADDED tax rates on the delivery item. The current account uses 10 when VAT applies.
LOYVERSE_DELIVERY_ADDED_TAX_RATE=0
LOYVERSE_SYNC_CUSTOMERS=true
# Regular expressions applied to Loyverse category names.
LOYVERSE_ONLINE_CATEGORY_PATTERN=fragrance
LOYVERSE_EXCLUDED_CATEGORY_PATTERN=tester

# HMAC key used to pseudonymize abuse-control fingerprints. Generate at least 32 random characters.
RATE_LIMIT_SECRET=replace_with_a_different_long_random_value

# Staff operations console. Keep both server-only and distinct from every integration secret.
OPERATIONS_PASSWORD=replace_with_a_unique_operator_password
# HMAC signing key for the HttpOnly operator session cookie. Generate at least 32 random characters.
OPERATIONS_SESSION_SECRET=replace_with_a_different_long_random_value
# Optional local visual-review records. Ignored in production even when set.
OPERATIONS_DEMO_MODE=false

# Netlify Blobs is provisioned automatically by Netlify and needs no credentials.
